# Backend Configuration (Production Example)
NODE_ENV=production
PORT=3001

# Database (Supabase)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
DATABASE_PUBLIC_SCHEMA=public

# Redis (Get free at upstash.com)
REDIS_URL=https://YOUR-UPSTASH-URL.upstash.io

# JWT (Generate a strong secret!)
JWT_SECRET=your-super-strong-jwt-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (Your Vercel frontend URL)
CORS_ORIGIN=https://your-app.vercel.app,https://*.vercel.app
